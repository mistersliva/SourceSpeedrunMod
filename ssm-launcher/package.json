{
  "name": "ssm-launcher",
  "productName": "SourceSpeedrunMod Launcher",
  "version": "1.2.1",
  "description": "Launcher for SourceSpeedrunMod",
  "author": "SourceSpeedrunMod",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.sourcespeedrunmod.launcher",
    "productName": "SourceSpeedrunMod Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "SSM-Launcher-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SourceSpeedrunMod",
      "uninstallDisplayName": "SourceSpeedrunMod Launcher",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
