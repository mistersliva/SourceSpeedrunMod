//-----------------------------------------------------------------------------
//	GAMEUI.VPC
//
//	HTML GameUI: menus, dialogs, loading screen and console are HTML/CSS/JS
//	rendered off-screen by Chromium Embedded Framework (CEF).
//
//	Prerequisites (done by build_htmlui_thirdparty.bat):
//	  * thirdparty\cef                     CEF binary distribution
//	  * gameui\cefbridge\out\lib\<config>  htmlhost.lib + libcef_dll_wrapper.lib
//	  * gameui\cefbridge\out\bin\Release   gameui_cefsub.exe
//-----------------------------------------------------------------------------

$macro SRCDIR		".."
$Macro OUTBINDIR	"$SRCDIR\..\game\bin"
$Macro GAMEDIR		"$SRCDIR\..\game"
$Macro CEFDIR		"$SRCDIR\thirdparty\cef"
$Macro CEFBRIDGEOUT	"$SRCDIR\gameui\cefbridge\out"

$include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;.\;$SRCDIR\vgui2\include;$SRCDIR\vgui2\controls;$SRCDIR\common\GameUI;$SRCDIR\common"
		$PreprocessorDefinitions		"$BASE;GAMEUI_EXPORTS"

		$EnableC++Exceptions			"Yes (/EHsc)"
	}

	$Linker
	{
		$AdditionalDependencies			"$BASE Gdi32.lib Shell32.lib User32.lib Advapi32.lib delayimp.lib htmlhost.lib libcef_dll_wrapper.lib libcef.lib" [$WINDOWS]
		// libcef.dll lives in bin\<arch>\cef and is loaded explicitly by htmlhost::Init().
		$DelayLoadedDLL					"$BASE libcef.dll" [$WINDOWS]
	}

	$PostBuildEvent [!$ANALYZE && $WINDOWS]
	{
		$CommandLine		"IF NOT EXIST $QUOTE$OUTBINDIR\cef$QUOTE MKDIR $QUOTE$OUTBINDIR\cef$QUOTE" "\n" \
							"XCOPY /Y /D /Q $QUOTE$CEFDIR\Release\*.dll$QUOTE $QUOTE$OUTBINDIR\cef\$QUOTE >nul" "\n" \
							"IF ERRORLEVEL 1 GOTO BuildEventFailed" "\n" \
							"XCOPY /Y /D /Q $QUOTE$CEFDIR\Release\*.bin$QUOTE $QUOTE$OUTBINDIR\cef\$QUOTE >nul" "\n" \
							"IF ERRORLEVEL 1 GOTO BuildEventFailed" "\n" \
							"XCOPY /Y /D /Q $QUOTE$CEFDIR\Release\*.json$QUOTE $QUOTE$OUTBINDIR\cef\$QUOTE >nul" "\n" \
							"IF ERRORLEVEL 1 GOTO BuildEventFailed" "\n" \
							"XCOPY /Y /D /Q /E /I $QUOTE$CEFDIR\Resources$QUOTE $QUOTE$OUTBINDIR\cef$QUOTE >nul" "\n" \
							"IF ERRORLEVEL 1 GOTO BuildEventFailed" "\n" \
							"XCOPY /Y /D /Q $QUOTE$CEFBRIDGEOUT\bin\Release\gameui_cefsub.exe$QUOTE $QUOTE$OUTBINDIR\cef\$QUOTE >nul" "\n" \
							"IF ERRORLEVEL 1 GOTO BuildEventFailed" "\n" \
							"XCOPY /Y /D /Q /E /I $QUOTE$SRCDIR\gameui\htmlui$QUOTE $QUOTE$GAMEDIR\platform\htmlui$QUOTE >nul" "\n" \
							"IF ERRORLEVEL 1 GOTO BuildEventFailed" "\n" \
							"$BASE"
	}
}

$Configuration "Debug"
{
	$Linker
	{
		$AdditionalLibraryDirectories	"$BASE;$CEFBRIDGEOUT\lib\Debug;$CEFDIR\Release"
	}
}

$Configuration "Release"
{
	$Linker
	{
		$AdditionalLibraryDirectories	"$BASE;$CEFBRIDGEOUT\lib\Release;$CEFDIR\Release"
	}
}

$Project "gameui"
{
	$Folder	"Source Files"
	{
		$File	"GameUI_Interface.cpp"
		$File	"GameConsole.cpp"
		$File	"HtmlUI.cpp"
		$File	"UiApi.cpp"
		$File	"UiAssets.cpp"
		$File	"Json.cpp"
		$File	"ModInfo.cpp"
		$File	"$SRCDIR\public\vgui_controls\vgui_controls.cpp"
	}

	$Folder	"Header Files"
	{
		$File	"EngineInterface.h"
		$File	"GameConsole.h"
		$File	"GameUI_Interface.h"
		$File	"HtmlUI.h"
		$File	"Json.h"
		$File	"ModInfo.h"
		$File	"UiApi.h"
		$File	"UiAssets.h"
		$File	"cefbridge\htmlhost.h"
	}

	$Folder	"Public Header Files"
	{
		$File	"$SRCDIR\common\GameUI\IGameUI.h"
		$File	"$SRCDIR\common\GameUI\IGameConsole.h"
		$File	"$SRCDIR\common\GameUI\IHtmlHud.h"
		$File	"$SRCDIR\public\IGameUIFuncs.h"
		$File	"$SRCDIR\public\tier1\interface.h"
	}

	$Folder	"HTML UI"
	{
		$File	"htmlui\index.html"
		$File	"htmlui\css\framework.css"
		$File	"htmlui\css\theme.css"
		$File	"htmlui\js\source.js"
		$File	"htmlui\js\ui.js"
		$File	"htmlui\js\app.js"
		$File	"htmlui\js\sounds.js"
		$File	"htmlui\hud.html"
		$File	"htmlui\css\hud.css"
		$File	"htmlui\js\hud.js"
	}

	$Folder	"Link Libraries"
	{
		$Lib	bitmap
		$Lib	mathlib
		$Lib	tier2
		$Lib	tier3
		$Lib	vgui_controls
		$Lib	vtf

	}
}
